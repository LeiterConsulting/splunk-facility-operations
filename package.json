{
  "name": "splunk-facility-operations",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "python3 scripts/serve_preview.py",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && tsx scripts/generate-lookups.ts && node scripts/build.mjs",
    "package": "npm run build && python3 scripts/package.py",
    "verify": "npm run test && npm run test:backend && npm run package",
    "test:browser": "playwright test",
    "test:backend": "python3 -m unittest discover -s tests -p \"test_*.py\""
  },
  "dependencies": {
    "@splunk/react-ui": "5.11.0",
    "@splunk/splunk-utils": "4.0.1",
    "@splunk/themes": "1.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "5.3.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/styled-components": "^5.1.34",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
